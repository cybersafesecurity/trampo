# Development preview. Never enable demo mode for a public commercial launch.
PORT=3002
DEMO_MODE=true
DATABASE_PATH=./data/trampo.sqlite
# Set this to the exact public HTTPS origin when deploying behind a proxy.
PUBLIC_ORIGIN=
# Google OpenID Connect (server-side authorization-code flow).
# Create a Web application OAuth client in Google Cloud Console and register
# exactly: <PUBLIC_ORIGIN>/api/auth/google/callback
# Keep the secret in .env or your host's secret manager; never prefix it VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to PUBLIC_ORIGIN/api/auth/google/callback.
GOOGLE_REDIRECT_URI=
# Metered TURN: either static credentials OR server-side expiring credentials.
# Never prefix these with VITE_. See docs/CALLING_TURN.md.
METERED_APP=
METERED_SECRET_KEY=
# Optional static Metered TURN fallback (also avoids first-call propagation delay).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional public STUN; direct/local WebRTC works without it.
STUN_URL=stun:stun.l.google.com:19302
# Recommended scalable media server: self-hosted LiveKit (Apache-2.0).
# The included calling implementation uses direct WebRTC, not LiveKit Cloud.
# See docs/ARCHITECTURE.md for the LiveKit + coturn deployment path.

# Optional Photon-compatible HTTPS geocoder for the Node backend. Defaults to
# https://photon.komoot.io (fair-use, no SLA). The live Edge Function uses PHOTON_URL.
PHOTON_URL=
