# Development preview. Never enable demo mode for a public commercial launch.
PORT=3000
DEMO_MODE=true
DATABASE_PATH=./data/trampo.sqlite
# Set this to the exact public HTTPS origin when deploying behind a proxy.
PUBLIC_ORIGIN=
# Optional browser WebRTC relay. STUN alone is not enough on restrictive networks.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional public STUN; direct/local WebRTC works without it.
STUN_URL=stun:stun.l.google.com:19302
# Recommended scalable media server: self-hosted LiveKit (Apache-2.0).
# The included calling implementation uses direct WebRTC, not LiveKit Cloud.
# See docs/ARCHITECTURE.md for the LiveKit + coturn deployment path.
