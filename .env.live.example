# Copy to .env.live for the Supabase-backed build. Only publishable values belong here.
VITE_TRAMPO_BACKEND=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Optional. Leave blank to use labelled OpenStreetMap/Photon address search.
VITE_GOOGLE_MAPS_API_KEY=
# Optional self-hosted Photon-compatible HTTPS endpoint for the static live build.
VITE_PHOTON_URL=
