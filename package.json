{
  "name": "trampo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Uganda-first ride hailing with verified pickup and private calling",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "tsc -b && vite build && node scripts/finalize-pwa.mjs dist",
    "build:pages": "tsc -b && vite build --mode pages --base=./ && node scripts/finalize-pwa.mjs dist",
    "build:pages:live": "tsc -b && vite build --mode live --base=/ --outDir dist && node scripts/finalize-pwa.mjs dist",
    "build:live": "tsc -b && vite build --mode live --base=/ --outDir dist-live && node scripts/finalize-pwa.mjs dist-live",
    "preview:live": "vite preview --mode live --host 0.0.0.0 --port 3004 --outDir dist-live",
    "preview:pages": "vite preview --mode pages --base=./ --host 0.0.0.0 --port 4173",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:live": "npm run build:live && playwright test --config=playwright.live.config.js",
    "check": "tsc -b",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:e2e:maps": "node scripts/test-maps-e2e.mjs",
    "test:pages": "npm run build:pages:live && node scripts/check-pages.mjs",
    "build:edge": "node scripts/build-edge.mjs"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@supabase/supabase-js": "^2.119.0",
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^5.1.0",
    "jose": "^6.2.15",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/google.maps": "^3.66.10",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "sharp": "^0.35.5",
    "typescript": "^5.8.3"
  }
}
