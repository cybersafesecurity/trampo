{
  "name": "trampo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Uganda-first ride hailing with verified pickup and private calling",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages --base=./",
    "build:pages:live": "tsc -b && vite build --mode live --base=./ --outDir dist",
    "build:live": "tsc -b && vite build --mode live --outDir dist-live",
    "preview:live": "vite preview --mode live --host 0.0.0.0 --port 3000 --outDir dist-live",
    "preview:pages": "vite preview --mode pages --base=./ --host 0.0.0.0 --port 4173",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^5.1.0",
    "jose": "^6.2.15",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  }
}
